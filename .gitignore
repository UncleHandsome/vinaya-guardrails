# 執行期與可重建之產物——不入庫
Python/
__pycache__/
*.pyc

# 列印產物（PDF／DOCX／HTML／中介 md／暖起點快取）：管線可重建，唯留管線自身
_print/*
!_print/build38.py
!_print/build_hulan.py
!_print/build_book.py
!_print/verify38.py
!_print/verify_hulan.py
!_print/print38.css
!_print/mmdcfg.json

# 階段備檔：git 即版本庫，備檔留磁碟即可
_archive/備份/

# 合併版（2026-10-19 奉令作廢）之封存：書身・產出・產器・暫存腳本留磁碟不入庫，
# 其已入庫者歷代內容仍可自 git 取回（清冊見 _archive/MOVED-20261019.txt 第二段）
_archive/合併版/

# 一次性工作器（內含本機絕對路徑・已用畢）
_merge/depath.py
_merge/depath2.py
_merge/precommit.py
_merge/sanitize.py
_work/b.log

# 目視之截圖（隨時可重生成：`python -X utf8 _work/presnap.py <pdf> [頁…]`）
_work/*.png

# 作業系統與同步盤之雜檔（永不入庫）
Thumbs.db
desktop.ini
.DS_Store
*.tmp
# 執行日誌與輸出（每輪可重生）
_work/*.log
_work/*.out
